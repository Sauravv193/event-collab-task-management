{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://event-collab-backend.onrender.com/api/$1"
    },
    {
      "source": "/actuator/(.*)",
      "destination": "https://event-collab-backend.onrender.com/actuator/$1"
    },
    {
      "source": "/ws/(.*)",
      "destination": "https://event-collab-backend.onrender.com/ws/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}
